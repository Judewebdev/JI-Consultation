# ---------------------------------------------------------------------------
# JI Global Academy — environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Database. SQLite by default so the app runs with zero infrastructure.
# For production switch prisma/schema.prisma `provider` to "postgresql"
# and use a connection string, e.g. postgresql://user:pass@host:5432/academy
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (HS256 JWT).
# Generate one with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin of the app, used to build payment redirects and absolute links.
# Read at runtime, so the same build can be deployed to staging and production.
APP_URL="http://localhost:3000"

# Same value, exposed to the browser. Only set this if client-side code needs
# it — unlike APP_URL it is inlined into the bundle when you run `next build`.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Payment gateway
# PAYMENTS_PROVIDER: "mock" | "stripe" | "paystack"
#   mock     – no network calls, checkout confirms instantly (dev/demo)
#   stripe   – Stripe Checkout Sessions
#   paystack – Paystack transaction initialisation (NGN/GHS/ZAR/KES)
# ---------------------------------------------------------------------------
PAYMENTS_PROVIDER="mock"
PAYMENTS_CURRENCY="USD"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Paystack
PAYSTACK_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Seed accounts (used by `npm run db:seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@jiglobalacademy.com"
SEED_ADMIN_PASSWORD="Academy!2345"
SEED_STUDENT_EMAIL="student@example.com"
SEED_STUDENT_PASSWORD="Student!2345"
