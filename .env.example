# 21st.dev CLI authentication
#
# Copy this file to .env and drop your real key in. .env is gitignored.
# Grab a key at https://21st.dev/mcp
#
# The CLI reads either of these automatically, no flag needed:
API_KEY_21ST=

# Alternative name the CLI also accepts. Set one or the other, not both.
# TWENTYFIRST_TOKEN=
